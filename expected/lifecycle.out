(1 row)

CREATE TEMP TABLE frozen_counts AS SELECT name, cpt FROM gaps.factor
WHERE model_id = gaps._model_id('lt') AND name <> 'pa';
SELECT gaps.set_frozen('lt', 'pa', false);
 set_frozen 
------------
 
